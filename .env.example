# Copy this file to .env for local overrides. Never commit real secrets.
AFTERCARE_ENVIRONMENT=local
AFTERCARE_DATABASE_URL=postgresql://aftercare:aftercare@postgres:5432/aftercare
AFTERCARE_REDIS_URL=redis://redis:6379/0
AFTERCARE_QDRANT_URL=http://qdrant:6333
AFTERCARE_CORS_ORIGINS=http://localhost:5173
AFTERCARE_HEALTH_TIMEOUT_SECONDS=2.0

# Used by Docker Compose only. Change these before any public deployment.
POSTGRES_DB=aftercare
POSTGRES_USER=aftercare
POSTGRES_PASSWORD=aftercare

